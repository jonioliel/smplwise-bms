# Keep the repository LF-only regardless of the contributor's OS.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp4 binary

# WisKey pinned contract catalogs: byte-exact copies of the delivered files (their SHA-256 is the provenance), so no
# line-ending normalisation.
docs/integrations/wiskey/catalog/**/*.json -text
docs/integrations/wiskey/catalog/**/LICENSE -text

# WisKey native integration bundle (WISKEY-ADOPT-2272): byte-exact to the delivered archive; its pin file lists every SHA-256.
smplwise_vms/integration/hikvision_intercom/** -text
