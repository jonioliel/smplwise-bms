<?xml version="1.0" encoding="utf-8"?>
<!--
    SmplWise Arx (own-WebView shell): a native server list (ServersActivity, the launcher) and one full-screen WebView per
    server (WebActivity). No browser, no Trusted Web Activity, no Digital Asset Links, no Google Play services.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the Hebrew error screen tells "no connection" from "server not reachable" -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- two-way audio only: asked at run time when the page requests the microphone (WebRTC); never for playback -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- the app lock: fingerprint / face (androidx.biometric) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- a phone without a microphone can still install the app -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".ArxApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:taskAffinity=""
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Arx"
        tools:targetApi="35">

        <!-- taskAffinity="" (above): no other app's activity can slip into this app's task (task hijacking, security
             review L10); WebActivity.open therefore replaces a running site itself instead of using task flags. -->
        <!-- Google Safe Browsing inside the WebView (the default since Android 8.1; stated explicitly) -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="true" />
        <!-- no usage metrics from this app's WebView to the WebView vendor -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <activity
            android:name=".ServersActivity"
            android:exported="true"
            android:theme="@style/Theme.Arx.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "החלף שרת" inside the site, and the icon's long-press shortcut -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="arx" android:host="servers" />
            </intent-filter>
            <!-- arx://open?url=https://<server>/arx/#/... : a link to a stored server (plain https links open in the
                 browser: there is no verified https filter, because the servers are known only at run time) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="arx" android:host="open" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- configChanges: rotation and resizing keep the same WebView (a playing video is not reloaded) -->
        <activity
            android:name=".WebActivity"
            android:exported="false"
            android:theme="@style/Theme.Arx.Web"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
