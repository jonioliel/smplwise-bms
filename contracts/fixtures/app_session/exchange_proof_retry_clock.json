{
  "description": "401 app_refresh_proof_retry, details.reason = clock: ts off by more than 300 s; nothing ended - new challenge, sign with server_time + elapsed, retry ONCE.",
  "name": "exchange_proof_retry_clock",
  "request": {
    "body": {
      "device_id": "<DEVICE_ID>",
      "install_id": "<INSTALL_ID>",
      "proof": {
        "nonce": "<NONCE>",
        "sig": "<SIGNATURE>",
        "ts": "<UNIX_SECONDS>"
      }
    },
    "headers": {
      "Authorization": "Bearer <ACCESS_TOKEN>",
      "Content-Type": "application/json",
      "X-Correlation-Id": "0123456789abcdef0123456789abcdef"
    },
    "method": "POST",
    "path": "/arx/api/v1/auth/app/session"
  },
  "response": {
    "body": {
      "code": "app_refresh_proof_retry",
      "correlation_id": "0123456789abcdef0123456789abcdef",
      "details": {
        "reason": "clock",
        "server_time": "<UNIX_SECONDS>"
      },
      "retryable": true,
      "user_message": "יש לחזור על הבקשה."
    },
    "headers": {
      "cache-control": "no-store",
      "content-type": "application/json",
      "x-correlation-id": "0123456789abcdef0123456789abcdef"
    },
    "status": 401
  }
}
