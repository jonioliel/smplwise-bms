{
  "description": "403 remote_mfa_required: an administrator without HA MFA while the installation requires it; nothing ended - let the WebView show its sign-in.",
  "name": "exchange_mfa_required",
  "request": {
    "body": {
      "device_id": "<DEVICE_ID>",
      "install_id": "<INSTALL_ID>",
      "proof": {
        "nonce": "<NONCE>",
        "sig": "<SIGNATURE>",
        "ts": "<UNIX_SECONDS>"
      }
    },
    "headers": {
      "Authorization": "Bearer <ACCESS_TOKEN>",
      "Content-Type": "application/json",
      "X-Correlation-Id": "0123456789abcdef0123456789abcdef"
    },
    "method": "POST",
    "path": "/arx/api/v1/auth/app/session"
  },
  "response": {
    "body": {
      "code": "remote_mfa_required",
      "correlation_id": "0123456789abcdef0123456789abcdef",
      "details": {},
      "retryable": false,
      "user_message": "למשתמשים עם הרשאות ניהול נדרש אימות דו־שלבי (MFA) לפני גישה מרחוק. הפעל אותו בפרופיל שלך."
    },
    "headers": {
      "cache-control": "no-store",
      "content-type": "application/json",
      "x-correlation-id": "0123456789abcdef0123456789abcdef"
    },
    "status": 403
  }
}
