{
  "description": "200: a one-time code for the WebView (60 s, single use); no Set-Cookie on the native answer.",
  "name": "exchange_ok",
  "request": {
    "body": {
      "device_id": "<DEVICE_ID>",
      "install_id": "<INSTALL_ID>",
      "proof": {
        "nonce": "<NONCE>",
        "sig": "<SIGNATURE>",
        "ts": "<UNIX_SECONDS>"
      }
    },
    "headers": {
      "Authorization": "Bearer <ACCESS_TOKEN>",
      "Content-Type": "application/json",
      "X-Correlation-Id": "0123456789abcdef0123456789abcdef"
    },
    "method": "POST",
    "path": "/arx/api/v1/auth/app/session"
  },
  "response": {
    "body": {
      "code": "<CODE>",
      "expires_at": "<ISO_8601_UTC>",
      "expires_in": 60,
      "redeem_path": "/arx/api/v1/auth/app/session/redeem"
    },
    "headers": {
      "cache-control": "no-store",
      "content-type": "application/json",
      "x-correlation-id": "0123456789abcdef0123456789abcdef"
    },
    "status": 200
  }
}
