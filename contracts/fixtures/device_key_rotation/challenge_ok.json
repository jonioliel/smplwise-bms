{
  "description": "200: a single-use nonce (120 s) for the device; the OLD key signs the replace message over it. No cookie.",
  "name": "challenge_ok",
  "request": {
    "body": {
      "device_id": "<DEVICE_ID>"
    },
    "headers": {
      "Content-Type": "application/json",
      "X-Correlation-Id": "0123456789abcdef0123456789abcdef"
    },
    "method": "POST",
    "path": "/arx/api/v1/auth/app/refresh-challenge"
  },
  "response": {
    "body": {
      "expires_at": "<ISO_8601_UTC>",
      "expires_in": 120,
      "nonce": "<NONCE>",
      "server_time": "<UNIX_SECONDS>"
    },
    "headers": {
      "cache-control": "no-store",
      "content-type": "application/json",
      "x-correlation-id": "0123456789abcdef0123456789abcdef"
    },
    "status": 200
  }
}
