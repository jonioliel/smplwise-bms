{
  "description": "201: the device moves to the NEW key with the OLD key's consent; the previous sign-in ends (`replaced`).",
  "name": "mint_replace_ok",
  "request": {
    "body": {
      "device_id": "<DEVICE_ID>",
      "device_key": {
        "alg": "ES256",
        "proof": {
          "sig": "<NEW_KEY_SIGNATURE>",
          "ts": "<UNIX_SECONDS>"
        },
        "public_key": "<NEW_PUBLIC_KEY>",
        "replaces": {
          "nonce": "<NONCE>",
          "sig": "<OLD_KEY_SIGNATURE>",
          "ts": "<UNIX_SECONDS>"
        }
      },
      "install_id": "<INSTALL_ID>"
    },
    "headers": {
      "Content-Type": "application/json",
      "Cookie": "<SESSION_COOKIE>",
      "Origin": "<ORIGIN>",
      "X-Correlation-Id": "0123456789abcdef0123456789abcdef"
    },
    "method": "POST",
    "path": "/arx/api/v1/auth/app/refresh-tokens"
  },
  "response": {
    "body": {
      "absolute_expires_at": "<ISO_8601_UTC>",
      "access_expires_at": "<ISO_8601_UTC>",
      "access_token": "<ACCESS_TOKEN>",
      "device_key": {
        "alg": "ES256",
        "bound": true
      },
      "expires_in": 600,
      "family_id": "<FAMILY_ID>",
      "proof_required": true,
      "refresh_expires_at": "<ISO_8601_UTC>",
      "refresh_token": "<REFRESH_TOKEN>",
      "token_type": "Bearer"
    },
    "headers": {
      "cache-control": "no-store",
      "content-type": "application/json",
      "x-correlation-id": "0123456789abcdef0123456789abcdef"
    },
    "status": 201
  }
}
