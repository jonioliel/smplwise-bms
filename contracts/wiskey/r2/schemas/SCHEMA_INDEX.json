  "contextual_invariants": [
    "HMAC and current connection challenge",
    "installation repository/entry identity and exactly one installed local bridge for Arx",
    "CAS/person/source revisions and original build_user business fields",
    "account/reference uniqueness and approved-template positional body/account mapping",
    "cursor source authentication/order and persisted snapshot completeness",
    "same intention never replayed after UNKNOWN; a correct schema is never sending authority"
