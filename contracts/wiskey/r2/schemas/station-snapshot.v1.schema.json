{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiskey.invalid/contracts/arx/v1/station-snapshot.v1.schema.json",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "contract": {
      "const": "wiskey-station-snapshot.v1"
    },
    "schema_version": {
      "const": 1
    },
    "station_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^camera\\.[a-z0-9_]+$"
    },
    "content_type": {
      "enum": [
        "image/jpeg",
        "image/png"
      ]
    },
    "encoding": {
      "const": "base64"
    },
    "image": {
      "type": "string",
      "minLength": 4,
      "maxLength": 800000,
      "contentEncoding": "base64"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    }
  },
  "required": [
    "contract",
    "schema_version",
    "station_id",
    "entity_id",
    "content_type",
    "encoding",
    "image",
    "observed_at"
  ],
  "additionalProperties": false
}
