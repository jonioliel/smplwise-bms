{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiskey.invalid/contracts/arx/v1/signed-event-envelope.v1.schema.json",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "kind": {
      "const": "wiskey-direct-reply.v1"
    },
    "connection_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "frame": {
      "$ref": "definitions.json#/$defs/EventFrame"
    },
    "sig": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "kind",
    "connection_ref",
    "frame",
    "sig"
  ],
  "additionalProperties": false
}
