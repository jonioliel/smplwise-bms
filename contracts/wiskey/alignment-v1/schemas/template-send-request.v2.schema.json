{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiskey.invalid/contracts/arx/alignment-v1/template-send-request.v2.schema.json",
  "x-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "operation_id",
    "recipient_ref",
    "expected_person_revision",
    "account",
    "template_name",
    "language",
    "template_ref",
    "expected_template_revision"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "recipient_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "expected_person_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "account": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "template_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,127}$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:_[A-Z]{2})?$"
    },
    "template_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "expected_template_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
