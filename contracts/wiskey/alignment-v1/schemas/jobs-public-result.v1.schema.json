{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiskey.invalid/contracts/arx/alignment-v1/jobs-public-result.v1.schema.json",
  "x-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "state",
    "revision",
    "created_at",
    "updated_at",
    "approval",
    "total",
    "saved",
    "failed",
    "pending",
    "errors"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "approval": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "action",
            "expires_at"
          ],
          "properties": {
            "state": {
              "enum": [
                "pending",
                "approved",
                "rejected"
              ]
            },
            "action": {
              "enum": [
                "resume",
                "retry_failed"
              ]
            },
            "expires_at": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "saved": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "pending": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
