{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiskey.invalid/contracts/arx/alignment-v1/jobs-approval-request.v1.schema.json",
  "x-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "revision",
    "action",
    "confirmed"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "action": {
      "enum": [
        "resume",
        "retry_failed"
      ]
    },
    "confirmed": {
      "const": true
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "display_name": {
          "type": "string"
        }
      }
    },
    "api_contract": {
      "type": "integer"
    }
  }
}
