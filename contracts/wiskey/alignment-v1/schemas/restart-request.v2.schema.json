{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiskey.invalid/contracts/arx/alignment-v1/restart-request.v2.schema.json",
  "x-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation_id",
    "claim_id",
    "source_digest",
    "expected"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "source_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "smplwise_bridge",
        "hikvision_intercom"
      ],
      "properties": {
        "smplwise_bridge": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hikvision_intercom": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
