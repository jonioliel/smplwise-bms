{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiskey.local/contracts/external-visits-v1/result.v1.schema.json",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visit_id",
    "revision",
    "arx_revision",
    "status"
  ],
  "properties": {
    "visit_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "arx_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "enum": [
        "approved",
        "ended"
      ]
    }
  }
}
