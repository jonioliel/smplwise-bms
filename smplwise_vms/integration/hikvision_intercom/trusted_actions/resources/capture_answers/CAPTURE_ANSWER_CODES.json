      "sent_unknown|no answer|invalid": "revoke(start_unknown), station held for the rest of 120 s, 504"
    },
    "capture_status": {
      "acknowledged": "state updated",
      "refused capture_not_found|lease_gone": "session expired/lost, ledger finished",
      "other refused|rejected|invalid": "ignored, next poll"
    },
    "capture_confirm": {
      "acknowledged + valid person": "confirmed, destroyed(confirmed)",
      "rejected | refused capture_not_ready|invalid_text": "back to captured",
      "refused capture_not_found|lease_gone": "lost",
      "other refused": "closed, destroyed(error)",
      "sent_unknown|no answer|invalid": "unconfirmed, destroyed(confirm_unknown), 'לא ידוע אם הכרטיס נוסף'"
    },
    "capture_cancel": {
      "acknowledged cancelled:true": "cancelled",
      "refused capture_not_found|lease_gone": "lost",
      "anything else": "cancel_unknown + revoke(cancel_unknown)"
    },
