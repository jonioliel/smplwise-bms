{
 "about": "SCROLL-AUDIT-2480: the reviewed overflow: auto | scroll rules that are NOT scroll debt (scripts/design_ratchet.py scroll-container counts every other one). Key = file below frontend/src + the rule's selector exactly as `design_ratchet.py --scroll-sites` prints it. Add an entry only for a rule of one of these kinds; a list on a control screen that scrolls is debt - page it (components/page-fit.ts, sw-pager). docs/changes/SCROLL-AUDIT-2480.md has the audit.",
 "kinds": {
  "dialog": "dialog / sheet / drawer / popover / menu body (the overlay scrolls, never the screen)",
  "picker": "a capped choice list inside a form, dialog or drawer",
  "strip-x": "a sideways strip (tabs, chips, segmented track, KPI row, timeline) when it is wider than its room",
  "table-x": "a table or chart that scrolls sideways when wider than its card",
  "viewer": "a text / code / log / JSON / document viewer or a textarea",
  "shell": "the app shell or a section frame (the page body itself)",
  "long-lists-scroll": "the installation's long-lists `scroll` fallback of a paged list (or the base rule the paged mode overrides)",
  "settings": "a settings / setup / tool page (not a control screen, DESIGN L1)",
  "editor": "a layout / plan / automation editor panel",
  "side-panel": "a narrow side panel or tree beside the main object (< 55 % of the window)",
  "phone": "applies only below the desktop edge (phone / tablet keep their scroll)",
  "component": "a shared component's own scroll contract",
  "map-overlay": "an overlay panel on a map stage, capped to the stage",
  "capped-in-card": "a short capped list inside one card",
  "public": "a public page outside the product shell (login, welcome, the public ticket page)"
 },
