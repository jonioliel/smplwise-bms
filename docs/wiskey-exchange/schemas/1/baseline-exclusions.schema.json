{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smplwise:arx-exchange:schemas:1:baseline-exclusions",
  "title": "Approved test-exclusions baseline (arx-exchange schema 1)",
  "description": "Versioned list of test cases that may be left out of the Arx gate, each with a justification, plus the mandatory tests that may never be excluded. A baseline file is immutable once approved; a change is a new baseline_version (BASELINE_EXCLUSIONS.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package",
    "baseline_version",
    "created_at",
    "applies_from_version",
    "previous",
    "approvals",
    "mandatory",
    "exclusions",
    "changes"
  ],
  "properties": {
    "schema": { "const": "arx-exchange/baseline-exclusions/1" },
    "package": { "const": "smplwise_intercom" },
    "baseline_version": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "#/$defs/utc_seconds" },
    "applies_from_version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$",
      "description": "First package version this baseline is valid for."
    },
    "previous": {
      "description": "null only for baseline_version 1.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline_version", "baseline_sha256"],
          "properties": {
            "baseline_version": { "type": "integer", "minimum": 1 },
            "baseline_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "approvals": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "description": "Roles only, no personal names. 'wiskey' and 'arx' are always required; 'owner' is required when a change touches a mandatory category or removes a door-related test (BASELINE_EXCLUSIONS.md 4).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["party", "date"],
        "properties": {
          "party": { "enum": ["wiskey", "arx", "owner"] },
          "date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" }
        }
      },
      "allOf": [
        { "contains": { "properties": { "party": { "const": "wiskey" } } } },
        { "contains": { "properties": { "party": { "const": "arx" } } } }
      ]
    },
    "mandatory": {
      "type": "array",
      "minItems": 1,
      "description": "Selectors for tests that must be collected and must pass in every gate run. An exclusion that matches a mandatory selector is a gate failure (R_MANDATORY_TEST_EXCLUDED), whatever its justification.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "match", "value", "reason"],
        "properties": {
          "category": {
            "enum": [
              "ha_required",
              "door_safety",
              "trusted_caller",
              "contract",
              "manifest_consistency",
              "storage_migration",
              "permissions_security",
              "install_safety"
            ]
          },
          "match": {
            "enum": ["node_id", "file", "marker"],
            "description": "node_id = exact pytest node id; file = every test in the file; marker = every test carrying the marker."
          },
          "value": { "type": "string", "minLength": 1, "maxLength": 500 },
          "min_count": {
            "type": "integer",
            "minimum": 1,
            "description": "For file/marker selectors: minimum number of collected tests that must match, so emptying a file is detected."
          },
          "reason": { "type": "string", "minLength": 10, "maxLength": 500 }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "category", "marker", "justification", "since_baseline"],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*\\.py(::[^\\s:][^\\s]*)*$"
          },
          "category": { "enum": ["hardware", "repo_only", "skip"] },
          "marker": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
          "justification": {
            "type": "string",
            "minLength": 20,
            "maxLength": 1000,
            "description": "Why it cannot run offline in the gate, and where it does run (WisKey CI, lab run, ...)."
          },
          "runs_elsewhere": {
            "type": "string",
            "maxLength": 200,
            "description": "Optional: where the test still runs (for example 'WisKey CI')."
          },
          "since_baseline": { "type": "integer", "minimum": 1 },
          "review_by": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
            "description": "Optional date by which a 'skip' exclusion must be re-justified or removed."
          }
        },
        "allOf": [
          {
            "if": { "properties": { "category": { "const": "skip" } } },
            "then": { "required": ["review_by"] }
          }
        ]
      }
    },
    "changes": {
      "type": "array",
      "description": "Diff against 'previous'. Empty for baseline_version 1.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "node_id", "reason"],
        "properties": {
          "action": { "enum": ["add_exclusion", "remove_exclusion", "change_justification", "add_mandatory", "remove_mandatory"] },
          "node_id": { "type": "string", "minLength": 1, "maxLength": 500 },
          "reason": { "type": "string", "minLength": 10, "maxLength": 1000 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "baseline_version": { "const": 1 } } },
      "then": { "properties": { "previous": { "type": "null" }, "changes": { "maxItems": 0 } } },
      "else": { "properties": { "previous": { "type": "object" } } }
    }
  ],
  "$defs": {
    "utc_seconds": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
