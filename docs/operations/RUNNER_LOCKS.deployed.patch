+class Hygiene(unittest.TestCase):
+    def test_debounce_waits_for_a_quiet_tip(self):
+        ready, deb = wl.debounce([("pilot/a", "s1")], {}, 1000, 240)
+        self.assertEqual(ready, [])
+        self.assertEqual(deb["pilot/a"], {"sha": "s1", "first": 1000})
+        ready, deb = wl.debounce([("pilot/a", "s1")], deb, 1100, 240)
+        self.assertEqual(ready, [])
+        ready, deb = wl.debounce([("pilot/a", "s1")], deb, 1240, 240)
+        self.assertEqual(ready, [("pilot/a", "s1")])
+
+    def test_debounce_new_push_restarts_the_clock(self):
+        deb = {"pilot/a": {"sha": "s1", "first": 1000}}
+        ready, deb = wl.debounce([("pilot/a", "s2")], deb, 1300, 240)
+        self.assertEqual(ready, [])
+        self.assertEqual(deb["pilot/a"], {"sha": "s2", "first": 1300})
+
+    def test_debounce_drops_finished_branches(self):
+        deb = {"pilot/a": {"sha": "s1", "first": 1000}, "pilot/b": {"sha": "t", "first": 1}}
+        ready, deb = wl.debounce([("pilot/a", "s1")], deb, 2000, 240)
+        self.assertEqual(ready, [("pilot/a", "s1")])
+        self.assertNotIn("pilot/b", deb)
+
+    def test_flag_active(self):
