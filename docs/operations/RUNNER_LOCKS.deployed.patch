+def debounce(todo, deb, now, quiet_s):
+    """Coalesce pushes per branch. todo: [(branch, sha)] (one entry per branch: its newest tip). deb: {branch:
+    {"sha", "first"}} remembered between passes. A branch runs only after its tip has been unchanged for quiet_s
+    seconds (first sighting of a new sha starts the clock), so a burst of pushes yields ONE run, for the newest sha.
+    Returns (ready [(branch, sha)], new_deb). Branches no longer in todo are dropped from deb."""
+    ready, new = [], {}
+    for b, sha in todo:
+        e = deb.get(b)
+        if not e or e.get("sha") != sha:
+            new[b] = {"sha": sha, "first": int(now)}
+            continue
+        new[b] = e
+        if now - int(e.get("first", now)) >= quiet_s:
+            ready.append((b, sha))
+    return ready, new
+
+
+def flag_active(mtime, now, max_age_s):
+    """A pending-flag file (gate / nightly waiting for the exclusive lock) counts only while it is younger than
+    max_age_s, so a stale file left by a crashed waiter cannot block the watcher forever. mtime None = no file."""
+    return mtime is not None and now - mtime < max_age_s
