{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smplwise.local/contracts/wiskey-capture-lease/answers/capture_confirm.answer.schema.json",
  "title": "capture_confirm answer (closed)",
  "description": "Closed answer of smplwise_bridge.lease_request action `capture_confirm` (wiskey-capture-lease-v1, M1/M2/M10 as decided). Validates the bridge's own answer object (the `service_response` of HA's return_response). Exactly one variant matches. Status: Arx answer to ARX-LEASE-RESPONSE, 2026-10-17; closes SCHEMA.md section 4 `lease_request` paragraph (lines 72-77); the route stays OFF (access.capture_lease=off, GO_LIVE_PERMITTED=False).",
  "$defs": {
    "uuid4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "employee_no",
        "display_name",
        "phone",
        "access_category",
        "responsible_person",
        "access_purpose",
        "archived_at",
        "access_timing_draft",
        "access_timing_policy",
        "active",
        "user_type",
        "valid_from",
        "valid_until",
        "assignments",
        "revision",
        "created_at",
        "updated_at",
        "identity_locked",
        "profile",
        "group_ids",
        "permission_overrides",
        "photo_configured",
        "pin_configured",
        "cards"
      ],
      "description": "Exactly WisKey ManagedUser.public() of the person after the card was added (access/models.py sha256 51d857b8...; the same object the legacy cards/capture_confirm and users/update answers return). Never pin, card_no or photo.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "employee_no": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "phone": {
          "type": "string"
        },
        "access_category": {
          "enum": [
            "staff",
            "visitor",
            "contractor"
          ]
        },
        "responsible_person": {
          "type": "string",
          "maxLength": 64
        },
        "access_purpose": {
          "type": "string",
          "maxLength": 128
        },
        "archived_at": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "access_timing_draft": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "Opaque here; the existing users/* timing contract governs its inside. Arx reads it through its timing_view projection."
        },
        "access_timing_policy": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "Opaque here; the existing users/* timing contract governs its inside. Arx reads it through its timing_view projection."
        },
        "active": {
          "type": "boolean"
        },
        "user_type": {
          "const": "normal"
        },
        "valid_from": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_until": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "assignments": {
          "type": "object",
          "propertyNames": {
            "maxLength": 64
          },
          "additionalProperties": {
            "$ref": "#/$defs/assignment"
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        },
        "identity_locked": {
          "type": "boolean"
        },
        "profile": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "group_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permission_overrides": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "maxLength": 64
          },
          "additionalProperties": {
            "enum": [
              "allow",
              "deny"
            ]
          }
        },
        "photo_configured": {
          "type": "boolean"
        },
        "pin_configured": {
          "type": "boolean"
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/person_card"
          }
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_entry_id",
        "enabled",
        "allowed_locks",
        "schedule_template",
        "desired_revision",
        "applied_revision",
        "sync_state",
        "last_sync_at",
        "last_error"
      ],
      "description": "WisKey StationAssignment.serialize() (access/models.py).",
      "properties": {
        "config_entry_id": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "allowed_locks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              1,
              2
            ]
          }
        },
        "schedule_template": {
          "type": "null"
        },
        "desired_revision": {
          "type": "integer",
          "minimum": 1
        },
        "applied_revision": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sync_state": {
          "enum": [
            "synced",
            "pending",
            "syncing",
            "offline",
            "conflict",
            "error",
            "delete_pending"
          ]
        },
        "last_sync_at": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_error": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "person_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "masked_number",
        "label",
        "card_type",
        "enabled"
      ],
      "description": "WisKey ManagedCard.public() (access/models.py).",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "masked_number": {
          "type": "string",
          "pattern": "^•{4}( [A-Za-z0-9_-]{4})?$"
        },
        "label": {
          "type": "string"
        },
        "card_type": {
          "const": "normalCard"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "request_id",
        "person"
      ],
      "description": "The card was saved to the person in WisKey storage (station sync follows; see assignments.sync_state). Not proof that a station applied it.",
      "properties": {
        "result": {
          "const": "acknowledged"
        },
        "request_id": {
          "$ref": "#/$defs/uuid4"
        },
        "person": {
          "$ref": "#/$defs/person"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "request_id",
        "code"
      ],
      "description": "The host (stage 8, WisKey) refused. For the session that remains after each code see CAPTURE_ANSWER_CODES.json `refused_liveness`.",
      "properties": {
        "result": {
          "const": "refused"
        },
        "request_id": {
          "$ref": "#/$defs/uuid4"
        },
        "code": {
          "enum": [
            "capture_not_ready",
            "invalid_text",
            "capture_operation_busy",
            "capture_not_found",
            "lease_gone",
            "binding_denied",
            "card_conflict",
            "revision_conflict"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "request_id"
      ],
      "description": "capture_confirm only: the host passed its confirm barrier and cannot say whether the card was added. No retry, no rollback.",
      "properties": {
        "result": {
          "const": "sent_unknown"
        },
        "request_id": {
          "$ref": "#/$defs/uuid4"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "stage",
        "code"
      ],
      "description": "Refused by the bridge (stages 1-4) before the schema stage passed: request_id MUST be absent (DTO v3 section 9).",
      "properties": {
        "result": {
          "const": "rejected"
        },
        "stage": {
          "enum": [
            "transport",
            "encoding",
            "parse",
            "schema"
          ]
        },
        "code": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "transport"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "transport_shape"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "const": "encoding"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "invalid_utf8",
                  "lone_surrogate",
                  "message_too_large"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "const": "parse"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "invalid_json",
                  "duplicate_key",
                  "non_json_constant",
                  "non_integer_number",
                  "integer_out_of_range",
                  "lone_surrogate",
                  "not_an_object"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "const": "schema"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "unknown_field",
                  "missing_field",
                  "wrong_type",
                  "bad_format",
                  "bad_value"
                ]
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "stage",
        "code",
        "request_id"
      ],
      "description": "Refused at stages 5-8 (binding, signature, time, state/replay) after the schema stage passed: request_id REQUIRED and equal to the request's. Nothing was done.",
      "properties": {
        "result": {
          "const": "rejected"
        },
        "stage": {
          "enum": [
            "binding",
            "signature",
            "time",
            "state"
          ]
        },
        "code": {
          "type": "string"
        },
        "request_id": {
          "$ref": "#/$defs/uuid4"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "binding"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "ts_mismatch",
                  "action_service_mismatch",
                  "station_scope_mismatch"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "const": "signature"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "bad_signature"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "const": "time"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "clock_invalid",
                  "lifetime_invalid",
                  "not_yet_valid",
                  "expired"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "const": "state"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "replay",
                  "storage_unavailable"
                ]
              }
            }
          }
        }
      ]
    }
  ]
}
