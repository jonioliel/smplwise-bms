{
  "name": "smplwise-vms-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "SMPLWISE VMS web UI (served by the Home Assistant add-on through Ingress)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:addon": "tsc --noEmit && vite build --outDir ../smplwise_vms/www --emptyOutDir",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "shots": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "rollup": "npm:@rollup/wasm-node@^4.63.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "overrides": {
    "rollup": "$rollup"
  }
}
