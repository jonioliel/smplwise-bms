        "evidence-plan-package.spec.ts": {"gate": false, "projects": ["desktop", "mobile"]},
        "evidence-curved-walls.spec.ts": {"gate": false, "projects": ["desktop", "mobile"]}
      }
    },
    "devices_floor": {
